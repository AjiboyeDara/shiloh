# ─────────────────────────────────────────────────────────────────────────
# Which model answers
# ─────────────────────────────────────────────────────────────────────────
# "ollama" (local, free, no API key — nothing leaves your machine),
# "gemini", or "anthropic". Ollama is the default so Shiloh works offline
# out of the box. Small local models do drop [n] citations more often; if
# answers feel loose, a free Gemini key is the cheapest upgrade. You can
# also switch per-question in the UI's model picker.
LLM_PROVIDER=ollama

# Ollama (used when LLM_PROVIDER=ollama)
# Install from https://ollama.com, then: ollama pull llama3.2
OLLAMA_MODEL=llama3.2
# OLLAMA_URL=http://localhost:11434

# Gemini (used when LLM_PROVIDER=gemini) — free-tier key at
# https://aistudio.google.com/. Also used as the judge in eval_answers.py.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Anthropic (used when LLM_PROVIDER=anthropic)
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-sonnet-4-5


# ─────────────────────────────────────────────────────────────────────────
# Search tuning — all optional. Re-run scripts/setup.py after changing
# anything that affects how passages are embedded or chunked.
# ─────────────────────────────────────────────────────────────────────────
# The sentence-transformers model used for both indexing and querying.
# Changing this REQUIRES rebuilding the index.
# EMBED_MODEL=all-MiniLM-L6-v2

# Some embedding models want a prefix on the query side (bge-family does).
# Set automatically by model name; override here if yours isn't recognised.
# EMBED_QUERY_PREFIX=

# Optional cross-encoder rerank pass over the fused results. Off by default:
# the ones tried so far scored below the baseline on KJV text (docs/RETRIEVAL.md).
# RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# How many candidates each retriever returns before fusion.
# RETRIEVAL_CANDIDATES=50
# Diversity cap so a thematic question spans the canon instead of one chapter.
# MAX_PER_CHAPTER=2
# Drop results scoring below this fraction of the top hit (min 3 always kept).
# MIN_SCORE_RATIO=0.45
# Cap on verses pulled in when widening a passage to its surrounding context.
# EXPAND_MAX_VERSES=40

# Pull in each top passage's cross-referenced verses as extra candidates.
# Built but unmeasured — see docs/RETRIEVAL.md before turning it on.
# CROSSREF_EXPAND=1

# Ask an LLM to restate the question in KJV vocabulary before searching.
# Measured worse than the hand-written synonym map; kept for experiments.
# QUERY_REWRITE=1
# REWRITE_PROVIDER=gemini
# REWRITE_MODEL=gemini-2.5-flash-lite


# ─────────────────────────────────────────────────────────────────────────
# Runtime
# ─────────────────────────────────────────────────────────────────────────
# Verse budget for expanding retrieved passages into the model's context.
# EXPAND_VERSE_BUDGET=150
# Load the embedding model at startup so the first question isn't slow.
# Set to 0 on a memory-tight host.
# WARM_ON_STARTUP=1


# ─────────────────────────────────────────────────────────────────────────
# Public hosting — all optional; see the README's self-hosting section.
# Defaults keep localhost development frictionless.
# ─────────────────────────────────────────────────────────────────────────
# Per-IP requests per minute; 0 disables both limits.
# CHAT_RATE_LIMIT=10       # chat endpoints, /api/search, /api/plan
# TOOL_RATE_LIMIT=         # /api/word-study; defaults to 6x CHAT_RATE_LIMIT
# TRUST_PROXY=1            # behind a reverse proxy: key limits on X-Forwarded-For
# CORS_ORIGINS=https://bible.example.com
# APP_PASSWORD=            # HTTP Basic gate on everything but /health
