# LLM provider: "ollama" (local, free, no API key), "gemini", or "anthropic"
LLM_PROVIDER=ollama

# Ollama settings (used when LLM_PROVIDER=ollama)
# Install from https://ollama.com, then: ollama pull llama3.2
OLLAMA_MODEL=llama3.2
# OLLAMA_URL=http://localhost:11434

# Gemini settings (used when LLM_PROVIDER=gemini)
# Free-tier key at https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Anthropic settings (used when LLM_PROVIDER=anthropic)
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-sonnet-4-5
